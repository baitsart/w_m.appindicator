#!/bin/sh
# prerm script for wallpaper-manager

set -e

# Detener el indicador en ejecución antes de proceder con la desinstalación
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    killall -9 wm-app-indicador 2>/dev/null || true
fi

case "$1" in
    remove|upgrade|deconfigure)
        # El gestor de paquetes (dpkg) se encarga automáticamente 
        # de eliminar los binarios y archivos del sistema instalados por el paquete.
    ;;

    failed-upgrade)
        # Acciones específicas en caso de fallo de actualización, si se requieren.
    ;;

    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
