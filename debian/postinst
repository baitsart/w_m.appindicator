#!/bin/bash
set -e

case "$1" in
configure)
    # 1. Detectar al usuario real de la sesión gráfica de forma infalible
    USER_NAME="${SUDO_USER}"
    if [ -z "$USER_NAME" ] || [ "$USER_NAME" = "root" ]; then
        USER_NAME=$(who | awk '{print $1}' | head -n 1)
    fi
    if [ -z "$USER_NAME" ] || [ "$USER_NAME" = "root" ]; then
        USER_NAME=$(awk -F: '$3 >= 1000 && $3 < 65534 {print $1; exit}' /etc/passwd)
    fi

    # 2. Aplicar permisos en la ruta compartida del sistema
    if [ -n "$USER_NAME" ] && [ "$USER_NAME" != "root" ]; then
        if [ -d /usr/share/wallpaper_manager ]; then
            chown -R "$USER_NAME:$USER_NAME" /usr/share/wallpaper_manager
            chmod -R 777 /usr/share/wallpaper_manager
        fi
    fi
;;
esac

exit 0
