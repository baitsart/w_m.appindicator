#!/bin/sh
set -e

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    killall -9 wm-app-indicador 2>/dev/null || true
fi

case "$1" in
    purge)
            rm -rf /usr/share/wallpaper_manager
            
            if [ -d  /home ]; then
                for homedir in /home/*; do
                    if [ -d  "$homedir" ]; then
                        rm -rf "$homedir/.wallpaper_manager"
                        rm -f "$homedir/.config/autostart/wm-app-indicador.desktop"
                        rm -f "$homedir/.local/share/applications/wallpaper_con_citas.desktop"
                        rm -f "$homedir/.local/share/applications/wallpaper_manager.desktop"
                        rm -f "$homedir/.config/autostart/Ciclar_wallpaper_citas.desktop"
                    fi
                done
            fi
    ;;
    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        # Acciones para remove normal
    ;;
    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

#DEBHELPER#

exit 0
