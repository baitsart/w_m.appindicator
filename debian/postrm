#!/bin/sh
set -e

users=$( who | awk '{print $1}' | sed '/^root$/d' | uniq )
homedir="/home/$users"

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    killall -9 wm-app-indicador 2>/dev/null || true
fi

case "$1" in
    purge)
            rm -rf /usr/share/wallpaper_manager
            rm -rf "$homedir/.wallpaper_manager"
            rm -f "$homedir/.config/autostart/wm-app-indicador.desktop"
            rm -f "$user_dir/.local/share/applications/wallpaper_con_citas.desktop"
            rm -f "$user_dir/.local/share/applications/wallpaper_manager.desktop"
            rm -f "$user_dir/.config/autostart/Ciclar_wallpaper_citas.desktop"
            
    ;;
    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        # Acciones para remove normal
    ;;
    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

#DEBHELPER#

exit 0
